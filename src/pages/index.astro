---
import '../styles/global.css';
import { getCollection } from 'astro:content';

const butunIcerikler = await getCollection('icerikler');

const sonIcerikler = butunIcerikler
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 9);
---

<!DOCTYPE html>
<html lang="tr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>gokbilim.net - Türkiye'nin Gökbilim Portalı</title>
  </head>
  <body class="bg-slate-950 text-slate-300 font-sans antialiased selection:bg-amber-500 selection:text-slate-900">
    
    <!-- Sabit Üst Menü (Sticky Navbar) -->
    <nav class="sticky top-0 z-50 bg-slate-950/80 backdrop-blur-md border-b border-slate-800">
      <div class="max-w-6xl mx-auto px-6 py-4 flex flex-wrap items-center justify-between gap-4">
        <a href="/" class="text-xl font-bold text-slate-100">
          <span class="text-amber-500">gokbilim</span>.net
        </a>
        <ul class="flex flex-wrap gap-4 text-sm font-medium text-slate-300">
          <li><a href="/kategori/haberler" class="hover:text-amber-500 transition-colors">Haberler</a></li>
          <li><a href="/kategori/gozlemevleri" class="hover:text-amber-500 transition-colors">Gözlemevleri</a></li>
          <li><a href="/kategori/etkinlikler" class="hover:text-amber-500 transition-colors">Etkinlikler</a></li>
          <li><a href="/kategori/haftanin-fotografi" class="hover:text-amber-500 transition-colors">Haftanın Fotoğrafı</a></li>
          <li><a href="/kategori/tarih" class="hover:text-amber-500 transition-colors">Gökbilim Tarihi</a></li>
        </ul>
      </div>
    </nav>

<!-- Kahraman (Hero) Alanı - Sadece Görsel -->
<header class="max-w-6xl mx-auto mt-8 px-6 mb-12">
      <!-- Mobil için h-64 (256px), masaüstü için h-[400px] -->
      <div class="relative w-full h-64 md:h-[400px] rounded-3xl overflow-hidden shadow-2xl flex flex-col items-center justify-center text-center border border-slate-800">
        
        <!-- Temiz Arka Plan Görseli -->
        <div class="absolute inset-0 bg-slate-900">
          <img src="/images/hero-bg.jpg" alt="Uzay Arka Planı" class="w-full h-full object-cover opacity-50 mix-blend-screen" />
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-slate-900/40 via-slate-950/80 to-slate-950"></div>
        </div>

        <!-- Yazılar (Ekran boyutuna göre otomatik ortalanır ve kesilmez) -->
        <div class="relative z-10 flex flex-col items-center px-4">
          <h1 class="text-3xl md:text-5xl font-extrabold text-slate-100 tracking-tight mb-2 md:mb-4 drop-shadow-lg">
            <span class="text-amber-500">gokbilim</span>.net
          </h1>
          <p class="text-base md:text-2xl text-slate-300 max-w-2xl mx-auto font-medium drop-shadow-md">
            Türkiye'nin Gökbilim Portalı
          </p>
        </div>
        
      </div>
    </header>

    <!-- Ana İçerik -->
    <main class="max-w-6xl mx-auto px-6 pb-24">
      
      <!-- Ortak İçerik Akışı Bölümü -->
      <section id="icerik-akisi">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sonIcerikler.map((icerik) => (
            <a href={`/icerikler/${icerik.id}`} class="group block h-full">
              <article class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden hover:border-slate-700 transition-all hover:shadow-[0_8px_30px_rgba(0,0,0,0.5)] flex flex-col h-full relative">
                
                {icerik.data.category && (
                  <div class="absolute top-4 left-4 z-10 bg-amber-500 text-slate-950 text-xs font-bold px-3 py-1 rounded-full shadow-lg">
                    {icerik.data.category}
                  </div>
                )}

                {icerik.data.image ? (
                  <div class="aspect-video overflow-hidden bg-slate-800 relative">
                    <img src={icerik.data.image} alt={icerik.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  </div>
                ) : (
                  <div class="aspect-video bg-slate-800 flex items-center justify-center">
                    <span class="text-slate-600">Görsel Yok</span>
                  </div>
                )}
                
                <div class="p-6 flex flex-col flex-grow">
                  <h3 class="text-xl font-bold text-slate-100 mb-3 group-hover:text-amber-500 transition-colors">
                    {icerik.data.title}
                  </h3>
                  
                  {icerik.data.importance && (
                    <div class="bg-amber-950/30 border-l-2 border-amber-500 p-3 mb-4 rounded-r-md">
                      <p class="text-sm text-amber-400"><strong>Özet:</strong> {icerik.data.importance}</p>
                    </div>
                  )}
                  
                  <p class="text-slate-400 text-sm line-clamp-3 mb-4 flex-grow">
                    {icerik.body.substring(0, 150)}...
                  </p>
                  
                  <div class="text-xs text-slate-500 pt-4 border-t border-slate-800 mt-auto flex justify-between items-center">
                    <span>{new Date(icerik.data.pubDate).toLocaleDateString('tr-TR')}</span>
                  </div>
                </div>
              </article>
            </a>
          ))}
        </div>
      </section>

    </main>
    
    <footer class="border-t border-slate-800 py-8 text-center text-slate-500 text-sm">
      <p>&copy; {new Date().getFullYear()} gokbilim.net - Tüm hakları saklıdır.</p>
    </footer>
  </body>
</html>