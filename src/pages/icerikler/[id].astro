---
import { getCollection, render } from 'astro:content';
import '../../styles/global.css';

export async function getStaticPaths() {
  const butunIcerikler = await getCollection('icerikler');
  
  // Tüm içerikleri tarihe göre sıralıyoruz (en yeniden en eskiye)
  const sirali = butunIcerikler.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

  return sirali.map((icerik) => {
    // Mevcut içeriğin kategorisindeki diğer yazıları filtreliyoruz
    const ayniKategori = sirali.filter((oge) => oge.data.category === icerik.data.category);
    
    // Bu içeriğin kendi kategorisi içindeki sırasını buluyoruz
    const index = ayniKategori.findIndex((oge) => oge.id === icerik.id);

    return {
      params: { id: icerik.id },
      props: { 
        icerik,
        // Sadece aynı kategori içindeki önceki ve sonraki içerikler
        onceki: index < ayniKategori.length - 1 ? ayniKategori[index + 1] : null,
        sonraki: index > 0 ? ayniKategori[index - 1] : null,
      },
    };
  });
}

const { icerik, onceki, sonraki } = Astro.props;
const { Content } = await render(icerik);
---

<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{icerik.data.title} - gokbilim.net</title>
  </head>
  <body class="bg-slate-950 text-slate-300 font-sans antialiased selection:bg-amber-500 selection:text-slate-900">
    
    <!-- Sabit Üst Menü -->
    <nav class="sticky top-0 z-50 bg-slate-950/80 backdrop-blur-md border-b border-slate-800">
      <div class="max-w-6xl mx-auto px-6 py-4 flex flex-wrap items-center justify-between gap-4">
        <a href="/" class="text-xl font-bold text-slate-100">
          <span class="text-amber-500">gokbilim</span>.net
        </a>
        <ul class="flex flex-wrap gap-4 text-sm font-medium text-slate-300">
          <li><a href="/kategori/haberler" class="hover:text-amber-500 transition-colors">Haberler</a></li>
          <li><a href="/kategori/gozlemevleri" class="hover:text-amber-500 transition-colors">Gözlemevleri</a></li>
          <li><a href="/kategori/etkinlikler" class="hover:text-amber-500 transition-colors">Etkinlikler</a></li>
          <li><a href="/kategori/haftanin-fotografi" class="hover:text-amber-500 transition-colors">Ayın Fotoğrafı</a></li>
          <li><a href="/kategori/tarih" class="hover:text-amber-500 transition-colors">Gökbilim Tarihi</a></li>
          <li><a href="/kategori/kutuphane" class="hover:text-amber-500 transition-colors">Gökbilim Kütüphanesi</a></li>
        </ul>
      </div>
    </nav>

    <main class="max-w-3xl mx-auto px-6 py-12 md:py-16">
      <article>
        <!-- Kategori Etiketi ve Tarih -->
        <div class="flex items-center gap-4 mb-6 text-sm">
          {icerik.data.category && (
            <span class="bg-amber-500 text-slate-950 font-bold px-3 py-1 rounded-full shadow-md">
              {icerik.data.category}
            </span>
          )}
          <time class="text-slate-500">{new Date(icerik.data.pubDate).toLocaleDateString('tr-TR')}</time>
        </div>

        <!-- Başlık -->
        <h1 class="text-3xl md:text-5xl font-extrabold text-slate-100 mb-8 leading-tight drop-shadow-md">
          {icerik.data.title}
        </h1>
        
        <!-- Görsel -->
        {icerik.data.image && (
          <img src={icerik.data.image} alt={icerik.data.title} class="w-full rounded-2xl mb-10 shadow-[0_10px_30px_rgba(0,0,0,0.5)] border border-slate-800" />
        )}
        
        <!-- Neden Önemli Bölümü -->
        {icerik.data.importance && (
          <div class="bg-amber-950/30 border-l-4 border-amber-500 p-5 mb-10 rounded-r-xl shadow-inner">
            <h2 class="text-lg font-bold text-amber-500 mb-2">Neden Önemli?</h2>
            <p class="text-amber-100/90 leading-relaxed">{icerik.data.importance}</p>
          </div>
        )}

        <!-- YENİ: Künye Bilgileri Bölümü (Gözlemevleri İçin) -->
        {icerik.data.kunye && (
          <div class="bg-blue-950/30 border-l-4 border-blue-500 p-6 mb-10 rounded-r-xl shadow-inner">
            <h2 class="text-lg font-bold text-blue-400 mb-4 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
              </svg>
              Künye ve Genel Bakış
            </h2>
            <ul class="space-y-2 text-blue-100/90 text-base">
              {icerik.data.kunye.konum && <li><strong class="text-blue-300">Konum:</strong> {icerik.data.kunye.konum}</li>}
              {icerik.data.kunye.rakim && <li><strong class="text-blue-300">Rakım:</strong> {icerik.data.kunye.rakim}</li>}
              {icerik.data.kunye.kurum && <li><strong class="text-blue-300">Bağlı Kurum:</strong> {icerik.data.kunye.kurum}</li>}
              {icerik.data.kunye.kurulus && <li><strong class="text-blue-300">Kuruluş Yılı:</strong> {icerik.data.kunye.kurulus}</li>}
              {icerik.data.kunye.kod && <li><strong class="text-blue-300">Gözlemevi Kodu:</strong> {icerik.data.kunye.kod}</li>}
            </ul>
          </div>
        )}
        
        <!-- Metin İçeriği -->
        <div class="prose prose-invert prose-amber max-w-none prose-lg md:prose-xl">
          <Content />
        </div>
      </article>

      <!-- Alt Gezinme Alanı (Önceki / Anasayfa / Sonraki) -->
      <nav class="mt-16 pt-8 border-t border-slate-800 flex flex-col md:flex-row justify-between items-center gap-6">
        <div class="flex-1 w-full md:w-auto">
          {onceki && (
            <a href={`/icerikler/${onceki.id}`} class="group flex flex-col items-start p-4 bg-slate-900/50 rounded-xl border border-transparent hover:border-slate-700 transition-all">
              <span class="text-xs text-slate-500 uppercase tracking-wider mb-2 group-hover:text-amber-500 transition-colors">&larr; Önceki</span>
              <span class="text-slate-300 font-medium group-hover:text-slate-100 transition-colors line-clamp-2">{onceki.data.title}</span>
            </a>
          )}
        </div>
        
        <!-- Anasayfa İkonu -->
        <div class="hidden md:flex flex-col items-center justify-center shrink-0">
          <a href="/" class="p-4 bg-slate-900 border border-slate-800 rounded-full text-slate-400 hover:text-amber-500 hover:border-slate-700 hover:bg-slate-800 transition-all shadow-lg" title="Anasayfaya Dön">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
          </a>
        </div>

        <div class="flex-1 w-full md:w-auto text-right">
          {sonraki && (
            <a href={`/icerikler/${sonraki.id}`} class="group flex flex-col items-end p-4 bg-slate-900/50 rounded-xl border border-transparent hover:border-slate-700 transition-all">
              <span class="text-xs text-slate-500 uppercase tracking-wider mb-2 group-hover:text-amber-500 transition-colors">Sonraki &rarr;</span>
              <span class="text-slate-300 font-medium group-hover:text-slate-100 transition-colors line-clamp-2">{sonraki.data.title}</span>
            </a>
          )}
        </div>
      </nav>
    </main>

    <footer class="border-t border-slate-800 py-8 text-center text-slate-500 text-sm mt-8">
      <p>&copy; {new Date().getFullYear()} gokbilim.net - Tüm hakları saklıdır.</p>
    </footer>
  </body>
</html>