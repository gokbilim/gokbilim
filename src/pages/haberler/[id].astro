---
import { getCollection, render } from 'astro:content';
import '../../styles/global.css';

export async function getStaticPaths() {
  const butunHaberler = await getCollection('icerikler');
  return butunHaberler.map(haber => ({
    params: { id: haber.id },
    props: { haber },
  }));
}

const { haber } = Astro.props;
const { Content } = await render(haber);
---

<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{haber.data.title} - gokbilim.net</title>
  </head>
  <body class="bg-slate-950 text-slate-300 font-sans antialiased">
    <main class="max-w-3xl mx-auto px-6 py-16">
      <a href="/" class="text-amber-500 hover:text-amber-400 mb-8 inline-block">&larr; Anasayfaya Dön</a>
      
      <article>
        <h1 class="text-3xl md:text-5xl font-bold text-slate-100 mb-6">{haber.data.title}</h1>
        <time class="text-slate-500 block mb-8">{new Date(haber.data.pubDate).toLocaleDateString('tr-TR')}</time>
        
        {haber.data.image && (
          <img src={haber.data.image} alt={haber.data.title} class="w-full rounded-xl mb-10" />
        )}
        
        <div class="prose prose-invert prose-amber max-w-none">
          <Content />
        </div>
      </article>
    </main>
  </body>
</html>
