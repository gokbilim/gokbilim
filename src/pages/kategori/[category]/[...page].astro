---
import '../../../styles/global.css';
import { getCollection } from 'astro:content';
import Navbar from '../../../components/Navbar.astro';

export const prerender = true;

export async function getStaticPaths({ paginate }) {
  const butunIcerikler = await getCollection('icerikler');

  // Kategori tanımlarına SEO için özel açıklamalar eklendi
  const kategoriler = [
    { slug: 'haberler', name: 'Haberler', description: 'Uzay araştırmaları, astronomi keşifleri ve gökbilim dünyasındaki en güncel haberler.' },
    { slug: 'gozlemevleri', name: 'Gözlemevleri', description: 'Türkiye ve dünyadaki önemli gözlemevleri, teleskoplar ve astronomik tesislerin teknik incelemeleri.' },
    { slug: 'etkinlikler', name: 'Etkinlikler', description: 'Göktaşı yağmurları, tutulmalar, astronomi festivalleri ve gökyüzü gözlem etkinlikleri takvimi.' },
    { slug: 'ayin-fotografi', name: 'Ayın Fotoğrafı', description: 'Derin uzay, gezegenler ve gökyüzü olaylarını konu alan astrofotografçıların çektiği ayın en iyi fotoğrafları.' },
    { slug: 'tarih', name: 'Gökbilim Tarihi', description: 'Antik çağlardan modern zamanlara astronomi tarihi, önemli gökbilimciler ve uzay biliminin evrimi.' },
    { slug: 'kutuphane', name: 'Gökbilim Kütüphanesi', description: 'Astronomi terimleri, uzay bilimi kavramları, makaleler ve gökbilim öğrenmek isteyenler için temel kaynaklar.' } 
  ];

  return kategoriler.flatMap(({ slug, name, description }) => {
    const filtrelenmis = butunIcerikler
      .filter((icerik) => icerik.data.category === name)
      .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

    return paginate(filtrelenmis, {
      params: { category: slug }, 
      props: { kategoriAdi: name, kategoriAciklamasi: description },
      pageSize: 9
    });
  });
}

const { page, kategoriAdi, kategoriAciklamasi } = Astro.props;

const sayfaUzantisi = page.currentPage > 1 ? ` - Sayfa ${page.currentPage}` : '';
const seoTitle = `${kategoriAdi} Kategorisi${sayfaUzantisi} | gokbilim.net`;

const etiketler = {
  'haberler': 'Neden Önemli:',
  'gökbilim tarihi': 'Ön Bilgi:',
  'gözlemevleri': 'Ön Bilgi:',
  'ayın fotoğrafı': 'Ön Bilgi:',
  'gökbilim kütüphanesi': 'Ön Bilgi:'
};
---

<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{seoTitle}</title>
    <meta name="description" content={kategoriAciklamasi} />
    
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={kategoriAciklamasi} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />

  </head>
  <body class="bg-slate-950 text-slate-300 font-sans antialiased selection:bg-amber-500 selection:text-slate-900">
    
    <Navbar aktifKategori={kategoriAdi} />

    <header class="max-w-6xl mx-auto px-6 pt-16 pb-12 text-center border-b border-slate-800/50 mb-12">
      <h1 class="text-4xl md:text-5xl font-extrabold text-slate-100 tracking-tight">
        {kategoriAdi}
      </h1>
    </header>

    <main class="max-w-6xl mx-auto px-6 pb-24 min-h-[40vh]">
      
      {page.data.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {page.data.map((icerik) => (
            <!-- YENİ: Kartın tamamını saran ana bağlantı (a) etiketi -->
            <a href={`/icerikler/${icerik.id.replace('.md', '')}`} class="group block h-full">
              <article class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden hover:border-slate-700 transition-all hover:shadow-[0_8px_30px_rgba(0,0,0,0.5)] flex flex-col h-full relative">
                
                <!-- YENİ: Kategori Etiketi (Tıklanamaz, Görsel Bilgi) -->
                {icerik.data.category && (
                  <span class="absolute top-4 left-4 z-10 bg-amber-500 text-slate-950 text-xs font-bold px-3 py-1 rounded-full shadow-lg">
                    {icerik.data.category}
                  </span>
                )}

                {icerik.data.image ? (
                  <div class="aspect-video overflow-hidden bg-slate-800 relative">
                    <img src={icerik.data.image} alt={icerik.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  </div>
                ) : (
                  <div class="aspect-video bg-slate-800 flex items-center justify-center">
                    <span class="text-slate-600">Görsel Yok</span>
                  </div>
                )}
                
                <div class="p-6 flex flex-col flex-grow">
                  <h3 class="text-xl font-bold text-slate-100 mb-3 group-hover:text-amber-500 transition-colors">
                    {icerik.data.title}
                  </h3>
                  
                  {icerik.data.importance && (
                    <div class="bg-amber-950/30 border-l-2 border-amber-500 p-3 mb-4 rounded-r-md">
                      <p class="text-sm text-amber-400">
                        <strong>{etiketler[icerik.data.category?.toLocaleLowerCase('tr-TR')] || 'Ön Bilgi:'}</strong> {icerik.data.importance}
                      </p>
                    </div>
                  )}
                  
                  <p class="text-slate-400 text-sm line-clamp-3 mb-4 flex-grow">
                    {icerik.body.substring(0, 150)}...
                  </p>
                  
                  <div class="text-xs text-slate-500 pt-4 border-t border-slate-800 mt-auto flex justify-between items-center">
                    <span>{new Date(icerik.data.pubDate).toLocaleDateString('tr-TR')}</span>
                  </div>
                </div>
              </article>
            </a>
          ))}
        </div>
      ) : (
        <div class="flex flex-col items-center justify-center text-center py-20">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-slate-700 mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
          </svg>
          <h2 class="text-2xl font-bold text-slate-400 mb-2">Henüz İçerik Yok</h2>
          <p class="text-slate-500 max-w-md">Bu kategoriye ait yazılar çok yakında eklenecektir. Lütfen daha sonra tekrar kontrol edin.</p>
        </div>
      )}

      { (page.url.prev || page.url.next) && (
        <nav class="flex items-center justify-between border-t border-slate-800 mt-16 pt-8">
          <div class="flex-1">
            {page.url.prev && (
              <a href={page.url.prev} class="inline-block px-5 py-3 bg-slate-900 border border-slate-700 rounded-xl text-slate-300 hover:bg-slate-800 hover:text-amber-500 hover:border-slate-600 transition-all shadow-md">
                &larr; Yeni İçerikler
              </a>
            )}
          </div>
          
          <div class="flex-1 text-center text-slate-500 text-sm font-medium">
            Sayfa {page.currentPage} / {page.lastPage}
          </div>

          <div class="flex-1 text-right">
            {page.url.next && (
              <a href={page.url.next} class="inline-block px-5 py-3 bg-slate-900 border border-slate-700 rounded-xl text-slate-300 hover:bg-slate-800 hover:text-amber-500 hover:border-slate-600 transition-all shadow-md">
                Önceki İçerikler &rarr;
              </a>
            )}
          </div>
        </nav>
      )}

    </main>
    
    <footer class="border-t border-slate-800 py-8 text-center text-slate-500 text-sm mt-8">
      <p>&copy; {new Date().getFullYear()} gokbilim.net - Tüm hakları saklıdır.</p>
    </footer>
  </body>
</html>