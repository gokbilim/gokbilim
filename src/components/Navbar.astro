---
const { aktifKategori = '' } = Astro.props;
---
<nav class="sticky top-0 z-50 bg-slate-950/80 backdrop-blur-md border-b border-slate-800">
  <div class="max-w-6xl mx-auto px-6 py-4 flex flex-wrap items-center justify-between gap-4">
    <a href="/" class="text-xl font-bold text-slate-100">
      <span class="text-amber-500">gokbilim</span>.net
    </a>
    <ul class="flex flex-wrap gap-4 text-sm font-medium text-slate-300">
      <li><a href="/kategori/haberler" class={`hover:text-amber-500 transition-colors ${aktifKategori === 'Haberler' ? 'text-amber-500' : ''}`}>Haberler</a></li>
      <li><a href="/kategori/gozlemevleri" class={`hover:text-amber-500 transition-colors ${aktifKategori === 'Gözlemevleri' ? 'text-amber-500' : ''}`}>Gözlemevleri</a></li>
      <li><a href="/kategori/etkinlikler" class={`hover:text-amber-500 transition-colors ${aktifKategori === 'Etkinlikler' ? 'text-amber-500' : ''}`}>Etkinlikler</a></li>
      <li><a href="/kategori/ayin-fotografi" class={`hover:text-amber-500 transition-colors ${aktifKategori === 'Ayın Fotoğrafı' ? 'text-amber-500' : ''}`}>Ayın Fotoğrafı</a></li>
      <li><a href="/kategori/tarih" class={`hover:text-amber-500 transition-colors ${aktifKategori === 'Gökbilim Tarihi' ? 'text-amber-500' : ''}`}>Gökbilim Tarihi</a></li>
      <li><a href="/kategori/kutuphane" class={`hover:text-amber-500 transition-colors ${aktifKategori === 'Gökbilim Kütüphanesi' ? 'text-amber-500' : ''}`}>Gökbilim Kütüphanesi</a></li>
    </ul>
    
    <!-- Arama Kutusu Alanı -->
    <div id="arama-kutusu" class="w-full lg:w-auto max-w-xs ml-auto"></div>
  </div>
</nav>

<!-- Pagefind Script ve Stilleri -->
<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script src="/pagefind/pagefind-ui.js" is:inline></script>

<script is:inline>
  window.addEventListener('DOMContentLoaded', (event) => {
    new PagefindUI({
      element: "#arama-kutusu",
      showSubResults: true,
      showImages: false,
      translations: {
        placeholder: "Sitede ara...",
        clear_search: "Temizle",
        load_more: "Daha fazla yükle",
        search_label: "Arama",
        filters_label: "Filtreler",
        zero_results: "[SEARCH_TERM] kelimesi bulunamadı",
        many_results: "[SEARCH_TERM] için [COUNT] sonuç",
        one_result: "[SEARCH_TERM] için 1 sonuç"
      }
    });
  });
</script>

<style is:global>
  /* gokbilim.net karanlık tema uyumluluğu */
  :root {
    --pagefind-ui-scale: 0.85;
    --pagefind-ui-primary: #f59e0b; /* amber-500 */
    --pagefind-ui-text: #cbd5e1; /* slate-300 */
    --pagefind-ui-background: #0f172a; /* slate-900 */
    --pagefind-ui-border: #1e293b; /* slate-800 */
    --pagefind-ui-tag: #1e293b;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0.75rem;
    --pagefind-ui-image-border-radius: 0.5rem;
    --pagefind-ui-image-box-ratio: 3 / 2;
    --pagefind-ui-font: inherit;
  }
  
  .pagefind-ui__search-input {
    outline: none !important;
  }
  .pagefind-ui__result-excerpt {
    color: #94a3b8 !important; /* slate-400 */
  }
</style>